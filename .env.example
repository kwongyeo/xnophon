# literature-review 환경변수 템플릿
# 실제 키는 .env (gitignore됨)에 동일한 형식으로 작성한다.

# OpenAlex polite pool (선택, 권장) — 식별 이메일을 등록하면 속도 제한이 완화된다.
OPENALEX_EMAIL=kwongyeo@gmail.com

# Anthropic API (선택) — 설정하면 CLI 챗봇이 Claude Opus 4.7로 자연어 대화 모드로 전환된다.
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# KCI Open API (선택, 추후 통합) — 발급 절차: docs/kci-api-setup.md
KCI_API_KEY=

# KOSIS Open API (필수: KOSIS MCP 서버 사용 시) — 국가통계포털 통계 데이터 수집
# 발급: https://kosis.kr/openapi/  ·  설정 절차: docs/kosis-mcp-setup.md
KOSIS_API_KEY=
