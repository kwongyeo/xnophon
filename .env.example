# literature-review 환경변수 템플릿
# 실제 키는 .env (gitignore됨)에 동일한 형식으로 작성한다.

# OpenAlex polite pool (선택, 권장) — 식별 이메일을 등록하면 속도 제한이 완화된다.
OPENALEX_EMAIL=kwongyeo@gmail.com

# Anthropic API (선택) — 설정하면 CLI 챗봇이 Claude Opus 4.7로 자연어 대화 모드로 전환된다.
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# KCI Open API (선택, 추후 통합) — 발급 절차: docs/kci-api-setup.md
KCI_API_KEY=

# =====================================================================
# ai_trader 서브프로젝트 (src/ai_trader/) — 자동매매용
# 발급 절차: src/ai_trader/docs/kis-api-setup.md
# =====================================================================

# 한국투자증권 OpenAPI — 모의투자 계정 (먼저 발급 후 검증)
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# 한국투자증권 OpenAPI — 실전 계정 (실거래 단계에서만 채움)
KIS_LIVE_APP_KEY=
KIS_LIVE_APP_SECRET=
KIS_LIVE_ACCOUNT_NO=

# 활성 환경 토글 (paper | live)
KIS_ENV=paper

# 알림 (선택) — 체결·에러 알림 채널
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
