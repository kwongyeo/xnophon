# stock-prediction 환경변수 템플릿
# 실제 키는 .env (gitignore됨)에 작성. 모든 키는 무료 발급 가능.

# OpenDART — 한국 재무·공시. 발급: https://opendart.fss.or.kr (인증키 신청)
DART_API_KEY=

# FRED — 미국 거시지표. 발급: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# 한국은행 ECOS — 한국 거시지표. 발급: https://ecos.bok.or.kr/api
ECOS_API_KEY=

# Naver 검색/DataLab — 뉴스·검색트렌드. 발급: https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Alpha Vantage (선택) — 미국 시세 대안. 발급: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Telegram 알림 (sp-notify) — 랭킹을 텔레그램으로 발송
#  1) @BotFather 에게 /newbot → 봇 생성 후 받은 토큰을 TELEGRAM_BOT_TOKEN 에
#  2) 만든 봇에게 아무 메시지나 보낸 뒤,
#     https://api.telegram.org/bot<토큰>/getUpdates 열어 "chat":{"id":...} 값을 TELEGRAM_CHAT_ID 에
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
