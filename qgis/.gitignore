# --- QGIS 작업 파일 ---
*.qgs~                  # 프로젝트 백업
*.qgz~
*.qgd                   # 프로젝트 보조 DB
.qgis2/

# --- 대용량 GIS 데이터 (출처에서 다시 받을 수 있는 것은 추적 제외) ---
# 벡터
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.sbn
*.sbx
# GeoPackage / SpatiaLite (대용량인 경우가 많음)
*.gpkg
*.gpkg-shm
*.gpkg-wal
*.sqlite
# 래스터
*.tif
*.tiff
*.img
*.vrt
*.asc
*.ovr            # 피라미드
*.aux.xml
# 압축 원본
*.zip
*.gz
*.7z

# --- 재생성 가능한 산출물 ---
outputs/maps/*
outputs/tables/*
outputs/reports/*
data/interim/*
data/processed/*

# --- QGIS 헤드리스 실행 런타임 부산물 ---
symbology-style.db
*.qgz.~lock~

# --- 자동 다운로드되는 경계 데이터 (make_population_map.py 가 재취득) ---
data/external/skorea-provinces-2018-geo.json

# --- 빈 폴더 구조는 유지 ---
!.gitkeep
